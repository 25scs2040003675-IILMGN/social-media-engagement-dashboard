# ============================================================
# .env.example — Template for environment variables
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file:  copy .env.example .env
# 2. Replace the placeholder values with your real credentials
# 3. NEVER commit the .env file to GitHub — it is already
#    listed in .gitignore

# ────────────────────────────────────────────────────────────
# YouTube Data API v3 key
# Get yours at: https://console.cloud.google.com/
# ────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_api_key_here

# ────────────────────────────────────────────────────────────
# Database configuration
# Set DATABASE_TYPE to "sqlite" (default) or "mysql"
# ────────────────────────────────────────────────────────────
DATABASE_TYPE=sqlite

# SQLite — path is relative to the project root
SQLITE_DATABASE_PATH=data/social_media.db

# MySQL — only needed when DATABASE_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=social_media_analytics

# ────────────────────────────────────────────────────────────
# Reporting timezone (used for posting-time analysis)
# Examples: Asia/Kolkata  |  America/New_York  |  UTC
# ────────────────────────────────────────────────────────────
REPORTING_TIMEZONE=Asia/Kolkata

# ────────────────────────────────────────────────────────────
# Analysis settings
# ────────────────────────────────────────────────────────────
# Minimum number of videos required before recommending a
# posting hour or day as "best"
MIN_SAMPLE_SIZE=5
